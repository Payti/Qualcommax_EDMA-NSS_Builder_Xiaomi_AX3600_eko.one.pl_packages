From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Builder <builder@local>
Date: Tue, 20 Oct 2026 21:00:00 +0200
Subject: [PATCH] glib2: add missing +libffi dependency to glib2-gobject

Signed-off-by: Builder <builder@local>
---
 glib2/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/glib2/Makefile b/glib2/Makefile
--- a/glib2/Makefile
+++ b/glib2/Makefile
@@ -190,7 +190,7 @@
 
 define Package/glib2-gobject
     SECTION:=libs
     CATEGORY:=Libraries
-    DEPENDS:=+glib2
+    DEPENDS:=+glib2 +libffi
     TITLE:=GObject - GLib object system
 endef